* text=auto
*.sh text eol=lf
*.ps1 text eol=crlf
# Files that end up inside the Joomla package are always checked out with LF,
# whatever the platform: the JED Checker flags CRLF in language files.
*.ini text eol=lf
*.php text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.sql text eol=lf
